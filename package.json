{
  "name": "code-context",
  "displayName": "CodeContext",
  "description": "Developer toolkit for exporting, importing, exploring, and sharing project context.",
  "version": "0.1.0",
  "publisher": "rasoolzia",
  "license": "MIT",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "code-context.exportContent",
        "title": "Content",
        "category": "CodeContext"
      },
      {
        "command": "code-context.exportTree",
        "title": "Project Tree",
        "category": "CodeContext"
      },
      {
        "command": "code-context.exportPaths",
        "title": "Paths",
        "category": "CodeContext"
      },
      {
        "command": "code-context.importContent",
        "title": "Import Content",
        "category": "CodeContext"
      },
      {
        "command": "code-context.importTree",
        "title": "Import Project Tree",
        "category": "CodeContext"
      },
      {
        "command": "code-context.importPaths",
        "title": "Import Paths",
        "category": "CodeContext"
      },
      {
        "command": "code-context.generateContextFromPaths",
        "title": "Generate Context from Paths",
        "category": "CodeContext"
      },
      {
        "command": "code-context.gitDiff",
        "title": "Diff",
        "category": "CodeContext"
      },
      {
        "command": "code-context.beforeAfterGitContext",
        "title": "Before/After",
        "category": "CodeContext"
      },
      {
        "command": "code-context.routeReport",
        "title": "Route Report",
        "category": "CodeContext"
      },
      {
        "command": "code-context.routeReportPreview",
        "title": "Route Report Preview",
        "category": "CodeContext"
      }
    ],
    "submenus": [
      {
        "id": "code-context.exportSubmenu",
        "label": "Export"
      },
      {
        "id": "code-context.gitSubmenu",
        "label": "Git"
      },
      {
        "id": "code-context.routesSubmenu",
        "label": "Routes"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "code-context.exportSubmenu",
          "group": "codecontext@1",
          "when": "resourceScheme == file"
        },
        {
          "submenu": "code-context.gitSubmenu",
          "group": "codecontext@2",
          "when": "resourceScheme == file"
        },
        {
          "submenu": "code-context.routesSubmenu",
          "group": "codecontext@3",
          "when": "resourceScheme == file"
        }
      ],
      "code-context.exportSubmenu": [
        {
          "command": "code-context.exportContent",
          "group": "codecontext@1",
          "when": "resourceScheme == file"
        },
        {
          "command": "code-context.exportTree",
          "group": "codecontext@2",
          "when": "resourceScheme == file"
        },
        {
          "command": "code-context.exportPaths",
          "group": "codecontext@3",
          "when": "resourceScheme == file"
        }
      ],
      "code-context.gitSubmenu": [
        {
          "command": "code-context.gitDiff",
          "group": "codecontext@1",
          "when": "resourceScheme == file"
        },
        {
          "command": "code-context.beforeAfterGitContext",
          "group": "codecontext@2",
          "when": "resourceScheme == file"
        }
      ],
      "code-context.routesSubmenu": [
        {
          "command": "code-context.routeReport",
          "group": "codecontext@1",
          "when": "resourceScheme == file"
        },
        {
          "command": "code-context.routeReportPreview",
          "group": "codecontext@2",
          "when": "resourceScheme == file"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.138.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
